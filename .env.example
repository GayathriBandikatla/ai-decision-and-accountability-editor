GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Google Cloud
GCP_PROJECT_ID=patchamomma26

# BigQuery
